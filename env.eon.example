# Template SINTÉTICO do eon (change migrate-production-to-eon, slice s2).
# Nunca usar em produção; valores reais vêm por --env-file no deploy.
# Sem comentário inline após o valor (lição do incidente --env-file).
# Substituir o placeholder pelo digest escolhido no slice s4.

EQMD_FRONTEND_IMAGE=<digest-a-definir-s4>

# Django
SECRET_KEY=synthetic-only-secret-key-change-me-000000000000000000000000
DEBUG=False
ALLOWED_HOSTS=equipemed.projetoshgrs.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://equipemed.projetoshgrs.com
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SITE_ID=1
LANGUAGE_CODE=pt-br
TIME_ZONE=America/Bahia
ACCOUNT_EMAIL_VERIFICATION=mandatory
OIDC_ISSUER=https://equipemed.projetoshgrs.com
DELEGATED_TOKEN_SECRET=synthetic-only-delegated-token-secret

# PostgreSQL (valores sintéticos; roles reais no slice s3)
POSTGRES_DB=eqmd_db
POSTGRES_USER=eqmd_user
POSTGRES_PASSWORD=synthetic-only-postgres-password
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=eqmd_db
DATABASE_USER=eqmd_user
DATABASE_PASSWORD=synthetic-only-postgres-password
DATABASE_HOST=postgres
DATABASE_PORT=5432

# E-mail sintético
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=synthetic-smtp-user
EMAIL_HOST_PASSWORD=synthetic-smtp-password
DEFAULT_FROM_EMAIL=noreply@example.invalid

# Hospital sintético
HOSPITAL_NAME=Hospital Sintetico
HOSPITAL_ADDRESS=Rua Sintetica 100
HOSPITAL_CITY=Salvador
HOSPITAL_STATE_FULL=Bahia
HOSPITAL_PHONE=+55-71-0000-0000
HOSPITAL_EMAIL=contato@example.invalid
HOSPITAL_WEBSITE=https://equipemed.projetoshgrs.com
HOSPITAL_LOGO_PATH=static/images/hospital-logo.png
HOSPITAL_LOGO_URL=
HOSPITAL_SHORT_ID=EQMD
HOSPITAL_CNES=0000000
HOSPITAL_CNPJ=00.000.000/0000-00

# PDF forms
HOSPITAL_PDF_FORMS_ENABLED=false
HOSPITAL_PDF_FORMS_PATH=media/pdf_forms
PDF_FORMS_MAX_FILE_SIZE=10485760
PDF_FORMS_REQUIRE_VALIDATION=true
