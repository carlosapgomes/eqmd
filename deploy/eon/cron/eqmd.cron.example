# EQMD cron jobs for the eon migration (slice s5).
# Installed SUSPENDED by default: every job line starts with "# EQMD_JOB ".
# E14 removes that marker; do not uncomment jobs before the cutover gate.
# Schedules are LOCAL time. Preflight D0 (2026-10-31) measured the eon host
# timezone as America/Bahia (same as the origin host), so the ORIGINAL origin
# schedules are used verbatim. Preflight gate: timedatectl MUST show
# America/Bahia before install; if the host TZ ever changes, stop and
# regenerate (see deploy/eon/cron/install-and-reverse.md).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# update_dashboard_stats — local (Bahia): */5 * * * * (identical in any TZ)
# EQMD_JOB */5 * * * * root flock -n /run/lock/eqmd-update-dashboard-stats.lock docker compose -f <EQMD_APP_DIR>/docker-compose.eon.yml --env-file <EQMD_APP_DIR>/env.eon exec -T eqmd python manage.py update_dashboard_stats

# update_ward_mapping_cache — local (Bahia): 2-59/5 * * * * (identical in any TZ)
# EQMD_JOB 2-59/5 * * * * root flock -n /run/lock/eqmd-update-ward-mapping-cache.lock docker compose -f <EQMD_APP_DIR>/docker-compose.eon.yml --env-file <EQMD_APP_DIR>/env.eon exec -T eqmd python manage.py update_ward_mapping_cache

# check_user_expiration — local (Bahia): 0 6 * * * (origin value, unchanged)
# EQMD_JOB 0 6 * * * root flock -n /run/lock/eqmd-check-user-expiration.lock docker compose -f <EQMD_APP_DIR>/docker-compose.eon.yml --env-file <EQMD_APP_DIR>/env.eon exec -T eqmd python manage.py check_user_expiration

# send_expiration_notifications — local (Bahia): 0 8 * * * (origin value, unchanged)
# EQMD_JOB 0 8 * * * root flock -n /run/lock/eqmd-send-expiration-notifications.lock docker compose -f <EQMD_APP_DIR>/docker-compose.eon.yml --env-file <EQMD_APP_DIR>/env.eon exec -T eqmd python manage.py send_expiration_notifications

# lifecycle_report — local (Bahia): 0 7 * * 0 (origin value, unchanged)
# EQMD_JOB 0 7 * * 0 root flock -n /run/lock/eqmd-lifecycle-report.lock docker compose -f <EQMD_APP_DIR>/docker-compose.eon.yml --env-file <EQMD_APP_DIR>/env.eon exec -T eqmd python manage.py lifecycle_report
